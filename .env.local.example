NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SERPAPI_API_KEY=your-serpapi-api-key
TURNSTILE_SITEKEY=your-turnstile-sitekey-here

# Stripe (Phase 1 monetization)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=https://shrinekeep.com

# Moderation (ban user, cancel Pro, purge storage, notify via Resend)
# Comma-separated emails allowed to use /moderation and moderation APIs (case-insensitive)
MODERATOR_EMAILS=you@example.com
RESEND_API_KEY=re_...
MODERATION_EMAIL_FROM=noreply@your-verified-domain.com
# Optional: comma-separated origins for cross-origin moderation API calls with credentials
# MODERATION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Social/public read rollout: keep false until media and legacy-policy cutover passes.
SOCIAL_PUBLIC_READS_ENABLED=false
SOCIAL_SHARING_EDITS_ENABLED=false
SOCIAL_MUTATIONS_ENABLED=false
# SOCIAL_MUTATIONS_ENABLED also gates authenticated social list/inbox routes.
# Public media signing shares SOCIAL_PUBLIC_READS_ENABLED. Keep false until private-bucket cutover.
# Enable the owner item privacy control only after the sharing migrations and server gate are ready.
NEXT_PUBLIC_SOCIAL_SHARING_EDITS_ENABLED=false
# Server-only signing secret: generate at least 32 random bytes before staged testing.
SHARING_CURSOR_SECRET=
